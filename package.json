{
  "name": "desktop-anime-companion",
  "version": "1.0.0",
  "description": "Transparent 3D Desktop Companion Overlay built with Electron and Three.js",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && .\\node_modules\\electron\\dist\\electron.exe .\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": ".\\node_modules\\electron\\dist\\electron.exe ."
  },
  "keywords": [
    "electron",
    "threejs",
    "desktop-companion",
    "overlay",
    "3d-avatar",
    "tamagotchi"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "canvas-confetti": "^1.9.3",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.165.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  }
}

